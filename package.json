    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrizzleGig/dsh-novel-kit.git"
  },
  "homepage": "https://github.com/DrizzleGig/dsh-novel-kit",
  "bugs": {
    "url": "https://github.com/DrizzleGig/dsh-novel-kit/issues"
  },
